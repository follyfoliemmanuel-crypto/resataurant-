{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__savora_path=$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-reports",
      "schedule": "0 6 * * 1"
    }
  ]
}
