# Configuration générale
# En production (Vercel) : NODE_ENV=production et APP_URL=https://votre-app.vercel.app
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=8787
APP_SECRET=remplacer_par_une_cle_secrete_d_au_moins_32_caracteres_en_production
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=postgresql://username:password@ep-example.eu-central-1.aws.neon.tech/savora?sslmode=require
DEFAULT_RESTAURANT_SLUG=maison-lumen

# Mots de passe des comptes créés par `npm run seed`
# (12+ caractères, majuscule, minuscule, chiffre). Ne jamais committer .env.
OWNER_PASSWORD=
CLIENT_PASSWORD=

# Resend (Service d'emails transactionnels)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Configuration SMTP (optionnel / alternative de secours)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Savora <noreply@localhost>"

# Google OAuth 2.0 / OpenID Connect
# Sur Vercel, laissez GOOGLE_REDIRECT_URI vide : l'URI est déduite de APP_URL
# (ou du domaine Vercel) → https://votre-app.vercel.app/api/auth/google/callback
# Cette URI exacte doit être autorisée dans Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Passerelle de paiement PayGate Global (Flooz / T-Money)
# Obligatoire pour accepter les webhooks de paiement en production.
PAYGATE_API_TOKEN=

# Vercel Cron — génération des rapports hebdomadaires
# Secret partagé : Vercel envoie « Authorization: Bearer <CRON_SECRET> ».
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
